[Unit]
Description=BrokerShark — dashboard web (sempre ativo)

[Service]
WorkingDirectory=/home/joao/Projetos/brokershark
Environment=PYTHONPATH=/home/joao/Projetos/brokershark/backend
# .env é carregado pelo bootstrap() (python-dotenv) a partir do WorkingDirectory.
ExecStart=/home/joao/Projetos/brokershark/.venv/bin/python backend/main.py
# validate() falho → SystemExit(1) → restart até o start-limit do systemd; o
# `status` mostra "start-limit-hit" (a mensagem real está no journalctl).
Restart=on-failure
RestartSec=2
# Hardening (least privilege; valid for --user units)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target

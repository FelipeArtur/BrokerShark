[Unit]
Description=BrokerShark — backup local mensal (timer)

[Timer]
# Checagem diária para um backup MENSAL: run_backup só escreve quando o snapshot
# do mês ainda não existe (keyed em ausência de arquivo), então rodar todo dia é
# o retry — Persistent=true só repõe execuções PERDIDAS (PC desligado), nunca
# execuções que rodaram e FALHARAM (ex.: HDD desmontado na virada do mês); a
# manhã seguinte cobre. Confirmar um import também refresca o snapshot do mês.
OnCalendar=*-*-* 07:00:00
Persistent=true

[Install]
WantedBy=timers.target

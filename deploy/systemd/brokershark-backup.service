[Unit]
Description=BrokerShark — backup local diário+mensal
After=network-online.target
Wants=network-online.target
# Falha real (exit 1) dispara o alerta de desktop — skip do mesmo dia sai 0.
OnFailure=brokershark-backup-alert.service

[Service]
Type=oneshot
WorkingDirectory=/home/joao/Projetos/brokershark
Environment=PYTHONPATH=/home/joao/Projetos/brokershark/backend
# .env é carregado pelo bootstrap() (python-dotenv) a partir do WorkingDirectory —
# mesma fonte/parsing do app, evitando divergência com o parser de EnvironmentFile.
ExecStart=/home/joao/Projetos/brokershark/.venv/bin/python -m jobs.backup
# Hardening (least privilege; valid for --user units)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

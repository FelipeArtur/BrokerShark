[Unit]
Description=BrokerShark — backup mensal local
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/joao/Projetos/brokershark
Environment=PYTHONPATH=/home/joao/Projetos/brokershark/backend
EnvironmentFile=/home/joao/Projetos/brokershark/.env
ExecStart=/home/joao/Projetos/brokershark/.venv/bin/python -m jobs.backup
# Hardening (least privilege; valid for --user units)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

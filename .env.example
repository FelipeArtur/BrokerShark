# Copie este arquivo para .env e preencha os valores

# Banco de dados (use caminho ABSOLUTO — relativo depende do cwd do processo)
DB_PATH=/home/SEU_USUARIO/brokershark/data/brokershark.db

# Dashboard (opcional — padrão: 8080)
DASHBOARD_PORT=8080

# Threads do servidor (opcional — padrão: 12). Single-user não precisa de mais:
# cobre uma carga de página (~10 chamadas paralelas) + algumas abas SSE abertas.
DASHBOARD_THREADS=12

# Auto-desligamento por ociosidade em MINUTOS (opcional — padrão: 30; 0 = nunca).
# Todas as abas fechadas (zero clientes SSE) + nenhum request por esse tempo → o app
# se desliga sozinho (SIGINT gracioso) e libera a RAM. CPU ocioso já é ~0%; isso
# recupera os ~40 MB quando você esquece o ./run.sh aberto.
IDLE_SHUTDOWN_MIN=30

# Ingestão — identificadores do próprio dono (nome e/ou fragmento de CPF, como
# aparecem nos extratos). Auto-Pix/TED entre suas contas são marcados como
# transferência (não contam como receita/despesa). Comma-separated.
OWNER_SELF_KEYWORDS=seu nome completo,fragmento-cpf

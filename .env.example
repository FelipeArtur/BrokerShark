# Copie este arquivo para .env e preencha os valores
TELEGRAM_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Banco de dados
DB_PATH=/home/SEU_USUARIO/brokershark/data/brokershark.db

# Backup local
LOCAL_BACKUP_DIR=/caminho/para/seu/backup/local

# Dashboard (opcional — padrão: 8080)
DASHBOARD_PORT=8080

# Ingestão — identificadores do próprio dono (nome e/ou fragmento de CPF, como
# aparecem nos extratos). Auto-Pix/TED entre suas contas são marcados como
# transferência (não contam como receita/despesa). Comma-separated.
OWNER_SELF_KEYWORDS=seu nome completo,fragmento-cpf

# Ollama — IA conversacional (qwen2.5:7b recomendado para RX 6600M)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=60

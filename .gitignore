# ── Python ──────────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── Caches de ferramentas (ruff/mypy/pytest) ────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node ────────────────────────────────────────────────────────────────
node_modules/

# ── Segredos / ambiente ─────────────────────────────────────────────────

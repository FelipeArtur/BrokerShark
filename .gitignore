.env
.env.*
!.env.example
credentials/

# ── Dados locais (nunca versionar) ──────────────────────────────────────
# data/ = SQLite (DB_PATH). docs/ = artefatos locais (PRODUCT.md = dados pessoais).
data/
backups/
logs/
*.log
docs/

# ── Tooling de agentes (local, fora do VCS) ─────────────────────────────
.agents/
.gstack/
.antigravitycli/
.claude/settings.local.json

# ── IDE / editor ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

#!/bin/sh
# BrokerShark Health Stack gate (CLAUDE.md "Health Stack antes de commitar").
# Blocks a commit when ruff / mypy / pytest are red, so a broken write path or a
# type error never lands on main again (see commit c2c467a: the checking-only
# pivot shipped a 500'ing POST /api/transactions because this gate wasn't run).
#
# Wired via:  git config core.hooksPath .githooks
# Bypass once (use sparingly):  git commit --no-verify
set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

PY=.venv/bin/python
if [ ! -x "$PY" ]; then
    echo "pre-commit: .venv not found at $ROOT/.venv — create it before committing"
    echo "            (python -m venv .venv && .venv/bin/pip install -r requirements.txt)"
    exit 1
fi

echo "pre-commit: ruff…"
.venv/bin/ruff check backend tests
echo "pre-commit: mypy…"
.venv/bin/mypy backend
echo "pre-commit: pytest…"
PYTHONPATH=backend "$PY" -m pytest -q
echo "pre-commit: health stack green."
